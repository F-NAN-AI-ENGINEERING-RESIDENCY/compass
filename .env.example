# Database
DATABASE_URL=postgresql+psycopg2://compass_user:compass_password@localhost:5432/compass_db

# Auth
SESSION_EXPIRE_HOURS=24
# "Continue with Google" — leave unset for local dev/tests; POST /api/auth/google
# 401s with a clear message rather than silently accepting any token when unset.
GOOGLE_OAUTH_CLIENT_ID=

# Video (Daily.co) + transcription (Groq Whisper). Leave provider settings as
# "stub" for local dev/tests — app.services.video / app.services.transcription
# fall back to fake, network-free implementations whenever they're "stub".
VIDEO_PROVIDER=stub
TRANSCRIPTION_PROVIDER=stub
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=
GROQ_API_KEY=
LESSON_INACTIVITY_TIMEOUT_MINUTES=15
ENABLE_LESSON_SCHEDULER=true

# AI Tutor (Gemini, temporary — swapping to Anthropic once API tokens are
# approved). Leave unset for local dev/tests — app.services.tutor falls back
# to a fake, network-free implementation whenever this is blank.
GEMINI_API_KEY=

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
